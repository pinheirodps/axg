{
  "name": "axg-node-sdk",
  "version": "0.4.0",
  "description": "Official Node.js SDK for Agent Execution Guard (AXG) token verification.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinheirodps/axg.git",
    "directory": "sdks/axg-node-sdk"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run"
  },
  "keywords": [
    "axg",
    "ai",
    "agent",
    "security",
    "governance",
    "passport",
    "guardrails"
  ],
  "author": "Danilo Silva <pinheirodps@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "jose": "^6.2.12",
    "json-stable-stringify": "^1.3.0"
  },
  "devDependencies": {
    "@types/json-stable-stringify": "^1.2.0",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
